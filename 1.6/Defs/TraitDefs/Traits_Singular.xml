<Defs>
    <TraitDef>
        <defName>RCP_DrugDealer</defName>
        <commonality>0.4</commonality>
        <degreeDatas>
            <li>
                <label>drug dealer</label>
                <description>[PAWN_nameDef] has a knack for cutting deals on illicit substances and can synthesize drugs with remarkable efficiency.</description>
                <statOffsets>
                    <DrugCookingSpeed>0.25</DrugCookingSpeed>
                    <DrugSynthesisSpeed>0.25</DrugSynthesisSpeed>
                    <DrugSellPriceImprovement>0.1</DrugSellPriceImprovement>
                </statOffsets>
                <possessions>
                    <Flake>5~10</Flake>
                </possessions>
                <disallowedMentalStates>
                    <li>Binging_DrugExtreme</li>
                    <li>Binging_DrugMajor</li>
                </disallowedMentalStates>
            </li>
        </degreeDatas>
        <requiredWorkTags>
            <li>Social</li>
            <li>Intellectual</li>
            <li>ManualSkilled</li>
        </requiredWorkTags>
        <conflictingTraits>
            <li>DrugDesire</li>
            <li>RCP_AcePilot</li>
            <li>RCP_Eloquent</li>
            <li>RCP_Fisherman</li>
            <li>RCP_GreenThumb</li>
            <li>RCP_Laborer</li>
        </conflictingTraits>
    </TraitDef>
    <TraitDef>
        <defName>RCP_Eloquent</defName>
        <commonality>0.4</commonality>
        <degreeDatas>
            <li>
                <label>eloquent</label>
                <description>[PAWN_nameDef] has the gift of gab. Negotiations come naturally to [PAWN_objective].</description>
                <statOffsets>
                    <SocialImpact>2</SocialImpact>
                    <NegotiationAbility>0.5</NegotiationAbility>
                    <TradePriceImprovement>0.5</TradePriceImprovement>
                    <ConversionPower MayRequire="Ludeon.Rimworld.Ideology">0.5</ConversionPower>
                </statOffsets>
                <possessions>
                    <Apparel_BowlerHat>1</Apparel_BowlerHat>
                </possessions>
            </li>
        </degreeDatas>
        <requiredWorkTags>
            <li>Social</li>
        </requiredWorkTags>
        <forcedPassions>
            <li>Social</li>
        </forcedPassions>
        <conflictingTraits>
            <li>RCP_AcePilot</li>
            <li>RCP_DrugDealer</li>
            <li>RCP_Fisherman</li>
            <li>RCP_GreenThumb</li>
            <li>RCP_Laborer</li>
        </conflictingTraits>
    </TraitDef>
    <TraitDef>
        <defName>RCP_GreenThumb</defName>
        <commonality>0.4</commonality>
        <degreeDatas>
            <li>
                <label>green thumb</label>
                <description>[PAWN_nameDef] is a plant whisperer. Working with crops comes naturally to [PAWN_objective].</description>
                <statOffsets>
                    <PlantWorkSpeed>0.25</PlantWorkSpeed>
                    <PlantHarvestYield>0.1</PlantHarvestYield>
                </statOffsets>
                <possessions>
                    <PlantPot>1</PlantPot>
                </possessions>
            </li>
        </degreeDatas>
        <requiredWorkTags>
            <li>PlantWork</li>
        </requiredWorkTags>
        <forcedPassions>
            <li>Plants</li>
        </forcedPassions>
        <conflictingTraits>
            <li>RCP_AcePilot</li>
            <li>RCP_DrugDealer</li>
            <li>RCP_Eloquent</li>
            <li>RCP_Fisherman</li>
            <li>RCP_Laborer</li>
        </conflictingTraits>
    </TraitDef>
    <TraitDef>
        <defName>RCP_Laborer</defName>
        <commonality>0.1</commonality>
        <degreeDatas>
            <li>
                <label>laborer</label>
                <description>[PAWN_nameDef] lacks the finesse for skilled tasks, but excels at hard, physical labor.</description>
                <statFactors>
                    <GeneralLaborSpeed>0.5</GeneralLaborSpeed>
                </statFactors>
                <statOffsets>
                    <CleaningSpeed>0.25</CleaningSpeed>
                    <CarryingCapacity>15</CarryingCapacity>
                </statOffsets>
            </li>
        </degreeDatas>
        <requiredWorkTags>
            <li>Cleaning</li>
            <li>Hauling</li>
            <li>ManualDumb</li>
        </requiredWorkTags>
        <disabledWorkTags>
            <li>ManualSkilled</li>
        </disabledWorkTags>
        <conflictingTraits>
            <li>RCP_AcePilot</li>
            <li>RCP_DrugDealer</li>
            <li>RCP_Eloquent</li>
            <li>RCP_Fisherman</li>
            <li>RCP_GreenThumb</li>
        </conflictingTraits>
    </TraitDef>
    <TraitDef MayRequire="Ludeon.RimWorld.Odyssey">
        <defName>RCP_AcePilot</defName>
        <commonality>0.4</commonality>
        <degreeDatas>
            <li>
                <label>ace pilot</label>
                <description>[PAWN_nameDef]'s heart yearns for the stars.</description>
                <statOffsets>
                    <PilotingAbility>0.5</PilotingAbility>
                </statOffsets>
                <possessions>
                    <PilotAssistant>1</PilotAssistant>
                </possessions>
            </li>
        </degreeDatas>
        <requiredWorkTags>
            <li>Intellectual</li>
        </requiredWorkTags>
        <forcedPassions>
            <li>Intellectual</li>
        </forcedPassions>
        <conflictingTraits>
            <li>RCP_DrugDealer</li>
            <li>RCP_Eloquent</li>
            <li>RCP_Fisherman</li>
            <li>RCP_GreenThumb</li>
            <li>RCP_Laborer</li>
        </conflictingTraits>
    </TraitDef>
    <TraitDef MayRequire="Ludeon.RimWorld.Odyssey">
        <defName>RCP_Fisherman</defName>
        <commonality>0.4</commonality>
        <degreeDatas>
            <li>
                <label>angler</label>
                <description>[PAWN_nameDef] loves casting lines. [PAWN_pronoun] catches fish faster than everyone else.</description>
                <statOffsets>
                    <FishingSpeed>0.25</FishingSpeed>
                    <FishingYield>0.1</FishingYield>
                </statOffsets>
                <possessions>
                    <Fish_Salmon>5~10</Fish_Salmon>
                </possessions>
            </li>
        </degreeDatas>
        <requiredWorkTags>
            <li>Animals</li>
        </requiredWorkTags>
        <forcedPassions>
            <li>Animals</li>
        </forcedPassions>
        <conflictingTraits>
            <li>RCP_AcePilot</li>
            <li>RCP_DrugDealer</li>
            <li>RCP_Eloquent</li>
            <li>RCP_GreenThumb</li>
            <li>RCP_Laborer</li>
        </conflictingTraits>
    </TraitDef>
</Defs>