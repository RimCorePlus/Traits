<Defs>
    <TraitDef>
        <defName>RCP_Brittle</defName>
        <commonality>0.8</commonality>
        <degreeDatas>
            <li>
                <label>brittle</label>
                <description>[PAWN_nameDef] is quick like a rabbit, and fragile like one, too.</description>
                <statOffsets>
                    <MoveSpeed>0.5</MoveSpeed>
                    <IncomingDamageFactor>0.25</IncomingDamageFactor>
                </statOffsets>
            </li>
        </degreeDatas>
        <conflictingTraits>
            <li>Tough</li>
            <li>Wimp</li>
            <li>SpeedOffset</li>
        </conflictingTraits>
    </TraitDef>
    <TraitDef>
        <defName>RCP_DrugDealer</defName>
        <commonality>0.4</commonality>
        <degreeDatas>
            <li>
                <label>dealer</label>
                <description>[PAWN_nameDef] knows the ins and outs of the underground market. [PAWN_pronoun] has a knack for cutting deals on illicit substances and can synthesize drugs with remarkable efficiency.</description>
                <statOffsets>
                    <DrugSellPriceImprovement>0.2</DrugSellPriceImprovement>
                    <DrugCookingSpeed>0.1</DrugCookingSpeed>
                    <DrugSynthesisSpeed>0.1</DrugSynthesisSpeed>
                </statOffsets>
                <possessions>
                    <Flake>5~10</Flake>
                </possessions>
                <disallowedMentalStates>
                    <li>Binging_DrugExtreme</li>
                    <li>Binging_DrugMajor</li>
                </disallowedMentalStates>
            </li>
        </degreeDatas>
        <conflictingTraits>
            <li>DrugDesire</li>
        </conflictingTraits>
        <requiredWorkTags>
            <li>Social</li>
            <li>Intellectual</li>
            <li>ManualSkilled</li>
        </requiredWorkTags>
    </TraitDef>
    <TraitDef>
        <defName>RCP_Eloquent</defName>
        <commonality>0.4</commonality>
        <degreeDatas>
            <li>
                <label>eloquent</label>
                <description>[PAWN_nameDef] speaks with ease and persuasion, often finding just the right words to charm others. [PAWN_pronoun] has a natural gift for communication, making [PAWN_objective] highly effective in social situations.</description>
                <statOffsets>
                    <SocialImpact>0.2</SocialImpact>
                    <NegotiationAbility>0.2</NegotiationAbility>
                    <TradePriceImprovement>0.1</TradePriceImprovement>
                    <ConversionPower MayRequire="Ludeon.Rimworld.Ideology">0.2</ConversionPower>
                </statOffsets>
            </li>
        </degreeDatas>
        <requiredWorkTags>
            <li>Social</li>
        </requiredWorkTags>
        <forcedPassions>
            <li>Social</li>
        </forcedPassions>
    </TraitDef>
    <TraitDef>
        <defName>RCP_GreenThumb</defName>
        <commonality>0.4</commonality>
        <degreeDatas>
            <li>
                <label>green thumb</label>
                <description>PLACEHOLDER</description>
                <statOffsets>
                    <PlantWorkSpeed>0.2</PlantWorkSpeed>
                    <PlantHarvestYield>0.1</PlantHarvestYield>
                    <DrugHarvestYield>0.1</DrugHarvestYield>
                </statOffsets>
            </li>
        </degreeDatas>
        <requiredWorkTags>
            <li>PlantWork</li>
        </requiredWorkTags>
        <conflictingTraits>
            <li>RCP_DrugDealer</li>
            <li>RCP_Laborer</li>
        </conflictingTraits>
        <forcedPassions>
            <li>Plants</li>
        </forcedPassions>
    </TraitDef>
    <TraitDef>
        <defName>RCP_Laborer</defName>
        <commonality>0.1</commonality>
        <degreeDatas>
            <li>
                <label>laborer</label>
                <description>[PAWN_nameDef] lacks the finesse for skilled tasks, but [PAWN_pronoun] excels at hard, physical labor.</description>
                <statOffsets>
                    <GeneralLaborSpeed>0.25</GeneralLaborSpeed>
                    <CleaningSpeed>0.25</CleaningSpeed>
                    <CarryingCapacity>15</CarryingCapacity>
                </statOffsets>
            </li>
        </degreeDatas>
        <requiredWorkTags>
            <li>Cleaning</li>
            <li>Hauling</li>
            <li>ManualDumb</li>
        </requiredWorkTags>
        <disabledWorkTags>
            <li>ManualSkilled</li>
        </disabledWorkTags>
        <conflictingTraits>
            <li>RCP_DrugDealer</li>
            <li>RCP_GreenThumb</li>
        </conflictingTraits>
    </TraitDef>
</Defs>