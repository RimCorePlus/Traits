<Patch>
    <Operation Class="ModSettingsFramework.PatchOperationModOption">
        <defaultValue>false</defaultValue>
        <label>Cap all trait commonality at 1</label>
        <id>RCP_TraitsFlattenTraitCommonality</id>
        <category>RCP_TraitsPatches</category>
        <order>0</order>
        <operations>
            <li Class="PatchOperationReplace">
                <xpath>//TraitDef/commonality[. > 1]/text()</xpath>
                <value>1</value>
            </li>
            <li Class="PatchOperationReplace">
                <xpath>//TraitDef/commonalityFemale[. > 1]/text()</xpath>
                <value>1</value>
            </li>
        </operations>
    </Operation>
    <Operation Class="ModSettingsFramework.PatchOperationModOption">
        <defaultValue>false</defaultValue>
        <label>Lower commonality for negative traits</label>
        <tooltip>Currently covers greedy, jealous, pyromaniac, and nudist</tooltip>
        <id>RCP_TraitsBadCommonality</id>
        <category>RCP_TraitsPatches</category>
        <order>1</order>
        <operations>
            <!--significantly reduce commonality of greedy (1) and jealous (1) traits-->
            <li Class="PatchOperationAdd">
                <xpath>//TraitDef[defName="Greedy" or defName="Jealous"]</xpath>
                <value>
                    <commonality>0.2</commonality>
                </value>
            </li>
            <!--and pyromaniac (0.8) and nudist (0.7)-->
            <li Class="PatchOperationReplace">
                <xpath>//TraitDef[defName="Pyromaniac" or defName="Nudist"]/commonality/text()</xpath>
                <value>0.2</value>
            </li>
        </operations>
    </Operation>
</Patch>