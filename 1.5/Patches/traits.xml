<Patch>
    <Operation Class="ModSettingsFramework.PatchOperationModOption">
        <defaultValue>false</defaultValue>
        <label>Replace trait skillgains with passion gains and stat offsets</label>
        <id>RCP_TraitsSkillGain</id>
        <category>RCP_TraitsPatches</category>
        <order>1</order>
        <operations>
            <!--brawler (keeping the shooting skill debuff)-->
            <li Class="PatchOperationRemove">
                <xpath>//TraitDef[defName="Brawler"]/degreeDatas/li/skillGains/Melee</xpath>
            </li>
            <li Class="PatchOperationAdd">
                <xpath>//TraitDef[defName="Brawler"]</xpath>
                <value>
                    <forcedPassions>
                        <li>Melee</li>
                    </forcedPassions>
                </value>
            </li>
            <!--gourmand-->
            <li Class="PatchOperationRemove">
                <xpath>//TraitDef[defName="Gourmand"]/degreeDatas/li/skillGains</xpath>
            </li>
            <li Class="PatchOperationAdd">
                <xpath>//TraitDef[defName="Gourmand"]</xpath>
                <value>
                    <forcedPassions>
                        <li>Cooking</li>
                    </forcedPassions>
                </value>
            </li>
            <!--sickly-->
            <li Class="PatchOperationRemove">
                <xpath>//TraitDef/degreeDatas/li[label="sickly"]/skillGains</xpath>
            </li>
            <li Class="PatchOperationAdd">
                <xpath>//TraitDef/degreeDatas/li[label="sickly"]</xpath>
                <value>
                    <statOffsets>
                        <MedicalTendQuality>0.30</MedicalTendQuality>
                    </statOffsets>
                </value>
            </li>
        </operations>
    </Operation>
</Patch>