<Patch>
    <Operation Class="ModSettingsFramework.PatchOperationModOption">
        <defaultValue>false</defaultValue>
        <label>[Combat Extended] Merge Bravery traits into Nerves traits</label>
        <tooltip>Adds suppressability from CE Bravery traits (Fearless, Cowardly, etc) to Nerves traits (Iron-willed, Nervous, etc) and lowers the commonality of CE Bravery traits to 0 so they don't generate on new pawns.</tooltip>
        <id>RCP_TraitsCEBravery</id>
        <category>RCP_TraitsModPatches</category>
        <order>101</order>
        <operations>
            <!--equivalent to "fearless"-->
            <li Class="PatchOperationAdd">
                <xpath>//TraitDef[defName="Nerves"]/degreeDatas/li[label="iron-willed"]/statOffsets</xpath>
                <value>
                    <Suppressability MayRequire="ceteam.combatextended">-1.0</Suppressability>
                </value>
            </li>
            <!--equivalent to "brave"-->
            <li Class="PatchOperationAdd">
                <xpath>//TraitDef[defName="Nerves"]/degreeDatas/li[label="steadfast"]/statOffsets</xpath>
                <value>
                    <Suppressability MayRequire="ceteam.combatextended">-0.5</Suppressability>
                </value>
            </li>
            <!--equivalent to "cowardly"-->
            <li Class="PatchOperationAdd">
                <xpath>//TraitDef[defName="Nerves"]/degreeDatas/li[label="nervous"]/statOffsets</xpath>
                <value>
                    <Suppressability MayRequire="ceteam.combatextended">0.25</Suppressability>
                </value>
            </li>
            <!--new value-->
            <li Class="PatchOperationAdd">
                <xpath>//TraitDef[defName="Nerves"]/degreeDatas/li[label="volatile"]/statOffsets</xpath>
                <value>
                    <Suppressability MayRequire="ceteam.combatextended">0.5</Suppressability>
                </value>
            </li>
            <!--reduce commonality of "Bravery" traits to 0, non-destructive removal-->
            <li Class="PatchOperationReplace">
                <xpath>//TraitDef[defName="Bravery"]/commonality/text()</xpath>
                <value>0</value>
            </li>
        </operations>
    </Operation>
</Patch>