        <modId>RCP.Traits</modId>
        <key>RCP_DrugDealer</key>
        <defaultValue>false</defaultValue>
        <caseTrue>
            <Operation Class="PatchOperationReplace">
                <xpath>//TraitDef[defName="RCP_DrugDealer"]/commonality/text()</xpath>
                <value>0</value>
            </Operation>
            <Operation Class="PatchOperationReplace">
                <xpath>//li[@Class="XmlExtensions.Setting.ToggleableSettings" and key="RCP_DrugDealer"]/caseFalse/li/xpath</xpath>
                <value>
                    <text>Changes are applied on restart.</text>
                </value>
            </Operation>
            <Operation Class="PatchOperationRemove">
                <xpath>//li[@Class="XmlExtensions.Setting.ToggleableSettings" and key="RCP_DrugDealer"]/caseTrue</xpath>
